Question: Count the number of digits in an integer.
Input: n = 54321
Output: 5


n = 54321
count = 0

while n > 0:
    digit = n % 10       # Get last digit
    count = count + 1    # Count one digit
    n = n // 10          # Remove last digit

print(count)             # Output: 5


